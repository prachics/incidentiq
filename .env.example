# ─────────────────────────────────────────────────────────────
# IncidentIQ configuration
# Copy to .env and fill in.  `.env` is gitignored; this file is not.
# ─────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=incidentiq
POSTGRES_PASSWORD=incidentiq_dev_password
POSTGRES_DB=incidentiq
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full URL used by the app. Inside Docker, host becomes `postgres`.
DATABASE_URL=postgresql://incidentiq:incidentiq_dev_password@localhost:5432/incidentiq

# ── LLM provider ────────────────────────────────────────────
# Which provider the agent uses: anthropic | ollama | stub
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=anthropic. Get one at console.anthropic.com.
# This is NOT your Claude Code subscription - it is separate, pay-per-token.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Used when LLM_PROVIDER=ollama (free, local).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ── Embeddings ──────────────────────────────────────────────
# local | openai
EMBEDDING_PROVIDER=local
# Local sentence-transformers model. 384 dimensions, ~130MB.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Only needed if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# ── Observability (Langfuse) ────────────────────────────────
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Secrets for the self-hosted Langfuse container itself.
# Generate with: openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=change-me-openssl-rand-hex-32
LANGFUSE_SALT=change-me-openssl-rand-hex-32
LANGFUSE_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# ── Agent behaviour ─────────────────────────────────────────
# Hard cap on plan -> execute_tool -> reflect loops per investigation.
MAX_ITERATIONS=8
# Retries per tool call before the agent gives up on that tool.
TOOL_MAX_RETRIES=3

# ── Failure injection (a feature, not a test fixture) ───────
# When true, tools fail at FAILURE_INJECTION_RATE to exercise recovery.
FAILURE_INJECTION_ENABLED=false
FAILURE_INJECTION_RATE=0.2
# Seed so injected failures are reproducible across eval runs.
FAILURE_INJECTION_SEED=42

# ── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
